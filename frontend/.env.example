# ─────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────
# In dev: /api (proxied to backend via vite.config.js)
# In production: full backend URL (e.g. https://your-api.com/api)
VITE_API_BASE_URL=/api

# ─────────────────────────────────────────────────────────────
# Backend Host (for dev proxy in vite.config.js)
# Change to your custom IP if backend is not on localhost
# Example: VITE_BACKEND_HOST=192.168.1.100
# ─────────────────────────────────────────────────────────────
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=5000

# ─────────────────────────────────────────────────────────────
# Google OAuth
# ─────────────────────────────────────────────────────────────
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
