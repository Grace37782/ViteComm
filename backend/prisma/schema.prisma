datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model Utilisateur {
  id_user       Int     @id @default(autoincrement())
  nom           String
  prenom        String
  email         String  @unique
  mot_de_passe  String
  statut_compte String  @default("Actif")
  est_admin     Boolean @default(false)
  photo_url     String?
  auth_provider String  @default("local")

  client           Client?
  vendeur          Vendeur?
  livreur          Livreur?
  signalementsAuteur Signalement[]  @relation("SignalementsAuteur")
  signalementsCible  Signalement[]  @relation("SignalementsCible")
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
}

model Client {
  id_user           Int         @id
  utilisateur       Utilisateur @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  adresse_livraison String

  commandes             Commande[]
  feedbacks             Feedback[]
  panier                Panier?
  paiementTransactions  PaiementTransaction[]
}

model Marche {
  id_marche   Int       @id @default(autoincrement())
  nom         String    @unique
  latitude    Float
  longitude   Float
  image_url   String?
  description String?

  vendeurs Vendeur[]
}

model Vendeur {
  id_user             Int         @id
  utilisateur         Utilisateur @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  nom_etablissement   String
  localisation_marche String
  id_marche           Int?
  marche              Marche?     @relation(fields: [id_marche], references: [id_marche], onDelete: SetNull)
  latitude            Float?
  longitude           Float?
  score_reputation    Float       @default(0.0)

  produits        Produit[]
  feedbacks       Feedback[]
  collecteVendeurs CollecteVendeur[]
}

model Livreur {
  id_user          Int         @id
  utilisateur      Utilisateur @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  type_vehicule    String
  immatriculation  String
  score_reputation Float       @default(0.0)

  livraisons         Livraison[]
  disponibilites     DisponibiliteLivreur[]
}

model DisponibiliteLivreur {
  id_dispo          Int      @id @default(autoincrement())
  date_mise_a_jour  DateTime @default(now())
  est_disponible    Boolean  @default(true)
  distance_marche   Float    @default(0.0)
  heure_debut_dispo String?
  heure_fin_dispo   String?
  id_user_livreur   Int

  livreur Livreur @relation(fields: [id_user_livreur], references: [id_user], onDelete: Cascade)
}

model Categorie {
  id_categorie          Int    @id @default(autoincrement())
  nom_categorie         String
  description_categorie String

  produits Produit[]
}

model Produit {
  id_produit       Int    @id @default(autoincrement())
  nom              String
  description      String
  prix_reference   Float
  stock_disponible Int
  unite            String @default("kg")
  id_user_vendeur  Int
  id_categorie     Int
  photo_url        String?
  created_at       DateTime @default(now())

  vendeur         Vendeur          @relation(fields: [id_user_vendeur], references: [id_user], onDelete: Cascade)
  categorie       Categorie        @relation(fields: [id_categorie], references: [id_categorie], onDelete: Restrict)
  detailsCommande DetailCommande[]
  detailsPanier   DetailPanier[]
  historiques     HistoriquePrix[]
}

model Panier {
  id_panier        Int      @id @default(autoincrement())
  date_creation    DateTime @default(now())
  date_mise_a_jour DateTime @updatedAt
  id_user_client   Int      @unique

  client  Client         @relation(fields: [id_user_client], references: [id_user], onDelete: Cascade)
  details DetailPanier[]
}

model DetailPanier {
  id_panier  Int
  id_produit Int
  quantite   Int

  panier  Panier  @relation(fields: [id_panier], references: [id_panier], onDelete: Cascade)
  produit Produit @relation(fields: [id_produit], references: [id_produit], onDelete: Cascade)

  @@id([id_panier, id_produit])
}

model Commande {
  id_commande          Int      @id @default(autoincrement())
  date_creation        DateTime @default(now())
  statut               String   @default("En attente")
  total_marchandises   Float
  frais_livraison      Float
  commission           Float    @default(0.0)
  code_verification    String
  id_user_client       Int
  mode_paiement        String   @default("ESPECES")
  mode_paiement_status String?
  validee_par_vendeur  Boolean  @default(false)

  client               Client               @relation(fields: [id_user_client], references: [id_user], onDelete: Cascade)
  detailsCommande      DetailCommande[]
  collecteVendeurs     CollecteVendeur[]
  livraison            Livraison?
  preuvesCollecte      PreuveCollecte[]
  factures             Facture[]
  paiementTransactions PaiementTransaction[]
}

model Livraison {
  id_livraison          Int       @id @default(autoincrement())
  date_prise_en_charge  DateTime  @default(now())
  date_fin_reelle       DateTime?
  statut_livraison      String    @default("En cours de collecte")
  preuve_collecte       String?   @db.Text
  frais_retour_calcules Float     @default(0.0)
  id_commande           Int       @unique
  id_user_livreur       Int
  dernier_scan_statut   String?
  dernier_scan_message  String?   @db.Text
  dernier_scan_at       DateTime?

  commande  Commande   @relation(fields: [id_commande], references: [id_commande], onDelete: Cascade)
  livreur   Livreur    @relation(fields: [id_user_livreur], references: [id_user], onDelete: Cascade)
  litiges   Litige[]
  feedbacks Feedback[]
  bons      BonDeLivraison[]
}

model DetailCommande {
  id_commande         Int
  id_produit          Int
  quantite_commandee  Int
  prix_vente_applique Float
  statut_acceptation  String @default("En attente")
  id_litige           Int?
  id_feedback         Int?

  commande Commande  @relation(fields: [id_commande], references: [id_commande], onDelete: Cascade)
  produit  Produit   @relation(fields: [id_produit], references: [id_produit], onDelete: Cascade)
  litige   Litige?   @relation(fields: [id_litige], references: [id_litige], onDelete: SetNull)
  feedback Feedback? @relation(fields: [id_feedback], references: [id_feedback], onDelete: SetNull)

  @@id([id_commande, id_produit])
}

model CollecteVendeur {
  id_collecte        Int      @id @default(autoincrement())
  id_commande        Int
  id_user_vendeur    Int
  statut_collecte    String   @default("en_attente") // en_attente, validee, collectee
  code_verification  String
  preuve_collecte    String?  // vendor QR token after scan
  qr_scanne_at      DateTime?
  created_at         DateTime @default(now())

  commande Commande @relation(fields: [id_commande], references: [id_commande], onDelete: Cascade)
  vendeur  Vendeur  @relation(fields: [id_user_vendeur], references: [id_user])

  @@unique([id_commande, id_user_vendeur])
}

model PreuveCollecte {
  id_preuve         Int      @id @default(autoincrement())
  date_heure        DateTime @default(now())
  statut_validation String   @default("En attente")
  id_commande       Int

  commande Commande      @relation(fields: [id_commande], references: [id_commande], onDelete: Cascade)
  medias   MediaPreuve[]
  litiges  Litige[]
}

model MediaPreuve {
  id_media   Int    @id @default(autoincrement())
  url_media  String
  type_media String @default("photo")
  id_preuve  Int

  preuve PreuveCollecte @relation(fields: [id_preuve], references: [id_preuve], onDelete: Cascade)
}

model Litige {
  id_litige         Int      @id @default(autoincrement())
  description       String
  date_ouverture    DateTime @default(now())
  statut            String   @default("Ouvert")
  statut_retour     String   @default("a_recuperer")
  decision_admin    String?
  montant_rembourse Float    @default(0.0)
  id_preuve         Int?
  id_livraison      Int

  preuve          PreuveCollecte?  @relation(fields: [id_preuve], references: [id_preuve], onDelete: SetNull)
  livraison       Livraison        @relation(fields: [id_livraison], references: [id_livraison], onDelete: Cascade)
  detailsCommande DetailCommande[]
}

model Feedback {
  id_feedback      Int      @id @default(autoincrement())
  note             Int
  commentaire      String?
  date_publication DateTime @default(now())
  type_feedback    String
  id_user_client   Int
  id_livraison     Int?
  id_user_vendeur  Int?

  client          Client           @relation(fields: [id_user_client], references: [id_user], onDelete: Cascade)
  livraison       Livraison?       @relation(fields: [id_livraison], references: [id_livraison], onDelete: SetNull)
  vendeur         Vendeur?         @relation(fields: [id_user_vendeur], references: [id_user], onDelete: SetNull)
  detailsCommande DetailCommande[]
}

model Signalement {
  id_signalement    Int      @id @default(autoincrement())
  date_heure        DateTime @default(now())
  motif             String
  statut_traitement String   @default("En attente")
  type_cible_cible  String
  id_auteur         Int
  id_cible          Int

  auteur Utilisateur @relation("SignalementsAuteur", fields: [id_auteur], references: [id_user], onDelete: Cascade)
  cible  Utilisateur @relation("SignalementsCible", fields: [id_cible], references: [id_user], onDelete: Cascade)
}

model HistoriquePrix {
  id_historique     Int      @id @default(autoincrement())
  prix              Float
  date_modification DateTime @default(now())
  id_produit        Int

  produit Produit @relation(fields: [id_produit], references: [id_produit], onDelete: Cascade)
}

model Facture {
  id_facture            Int      @id @default(autoincrement())
  date_emission         DateTime @default(now())
  montant_marchandises  Float
  montant_frais_livraison Float
  montant_frais_retour  Float    @default(0.0)
  montant_commission    Float    @default(0.0)
  montant_total_du      Float
  statut_paiement       String   @default("En attente")
  id_commande           Int

  commande Commande  @relation(fields: [id_commande], references: [id_commande], onDelete: Cascade)
  paiements Paiement[]
}

model Paiement {
  id_paiement          Int      @id @default(autoincrement())
  date_paiement        DateTime @default(now())
  montant_percu        Float
  mode_reglement       String   @default("ESPECES")
  reference_transaction String?
  statut               String   @default("Effectue")
  id_facture           Int

  facture Facture @relation(fields: [id_facture], references: [id_facture], onDelete: Cascade)
}

model PaiementTransaction {
  id_paiement_transaction Int      @id @default(autoincrement())
  id_user_client          Int
  id_commande             Int
  montant                 Float
  devise                  String   @default("XOF")
  mode_paiement           String
  telephone               String?
  transaction_id          String   @unique
  fedapay_transaction_id  String?
  statut                  String   @default("pending")
  provider                String   @default("fedapay")
  provider_response       Json?
  failure_reason          String?
  paid_at                 DateTime?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  client   Client   @relation(fields: [id_user_client], references: [id_user], onDelete: Cascade)
  commande Commande @relation(fields: [id_commande], references: [id_commande], onDelete: Cascade)
}

model VerificationToken {
  id         Int      @id @default(autoincrement())
  email      String
  code       String
  token      String   @unique
  data       String   @db.Text // JSON: full registration payload
  role       String   // client | vendeur | livreur
  expires_at DateTime
  created_at DateTime @default(now())
}

model PasswordResetToken {
  id         Int      @id @default(autoincrement())
  email      String
  code       String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
}

model BonDeLivraison {
  id_bon                Int      @id @default(autoincrement())
  date_emission         DateTime @default(now())
  date_signature_client DateTime?
  statut_bon            String   @default("EN_ATTENTE")
  observations_livreur  String?
  id_livraison          Int

  livraison Livraison @relation(fields: [id_livraison], references: [id_livraison], onDelete: Cascade)
}

model Notification {
  id          Int      @id @default(autoincrement())
  titre       String
  message     String
  type        String   // order, payment, delivery, feedback, system
  reference   String?  // e.g. "order:155" or "delivery:42"
  lu          Boolean  @default(false)
  id_user     Int
  created_at  DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [id_user], references: [id_user], onDelete: Cascade)

  @@index([id_user, lu])
  @@index([id_user, created_at])
}

model PushSubscription {
  id           Int      @id @default(autoincrement())
  endpoint     String
  p256dh       String
  auth         String
  id_user      Int
  created_at   DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [id_user], references: [id_user], onDelete: Cascade)

  @@unique([endpoint, id_user])
}
