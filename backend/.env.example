# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
APP_ENV=local                  # local | development | production
APP_URL=http://localhost:5000  # Your backend public URL
APP_DEBUG=true                 # Set to false in production
CORS_ORIGINS=                  # Comma-separated frontend URLs (ignored in dev)

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=5000

# ─────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────
# Mail (Gmail SMTP)
# ─────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME=ViteComm

# ─────────────────────────────────────────────────────────────
# Google OAuth
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:5000/api/auth/google/callback

# ─────────────────────────────────────────────────────────────
# FedaPay (Mobile Money)
# ─────────────────────────────────────────────────────────────
FEDAPAY_SECRET_KEY=sk_your_key
FEDAPAY_WEBHOOK_SECRET=wh_your_secret
FEDAPAY_ENVIRONMENT=sandbox    # sandbox | production
FEDAPAY_BASE_URL=https://sandbox-api.fedapay.com
